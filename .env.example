# =============================================================================
# Quiver — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all values.
# Each variable is documented with where to find its value.

# -----------------------------------------------------------------------------
# Database (Postgres on Neon)
# -----------------------------------------------------------------------------
# The middleware checks membership through Neon's HTTP driver
# (lib/middleware-db.ts), so the app database has to be a Neon database.
# Vercel: Storage → Neon (Marketplace) creates it and fills these in.

# Postgres connection string (pooled).
# Neon: Connection Details → "Pooled connection"
DATABASE_URL=

# Direct connection URL for Prisma migrations (non-pooled).
# Neon: Connection Details → turn off "Connection pooling"
DIRECT_URL=

# -----------------------------------------------------------------------------
# Supabase (authentication only)
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Supabase: Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key — safe for client-side use.
# Supabase: Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, never expose to client.
# Supabase: Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------

# Your Anthropic API key — used for all AI sessions.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Your deployment URL (e.g. https://gtm.smartconsultingzauner.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for generating session share links. Generate with: openssl rand -base64 32
# Without this, attempts to share sessions will return an error.
QUIVER_SHARE_SECRET=

# -----------------------------------------------------------------------------
# Security for public deployments
# -----------------------------------------------------------------------------

# Bearer token for the remote MCP endpoint /api/mcp. Set it on every public
# deployment: without it the endpoint accepts unauthenticated requests,
# including tools that change context and content.
# Generate with: openssl rand -base64 32
MCP_AUTH_SECRET=

# Secret Vercel Cron sends to /api/cron/pattern-report (monthly pattern report).
# Without it the cron job returns early in production.
# Generate with: openssl rand -base64 32
CRON_SECRET=
